# 运行 python3 deploy/generate-config.py 初始化 .env（0600）和结构 JSON。
# Token、模型、功能开关及日志选项只在本文件配置，JSON 不再接受这些字段。
# 此示例没有真实凭据；.env 与 .env.* 不提交、不复制进镜像。
COMPOSE_PROJECT_NAME=ffmpeg-agent
MEDIA_IMAGE=ffmpeg-agent:v1-local
BUILD_REVISION=local

# 默认仅本机可访问；远程调用通过受控 HTTPS 入口转发。
MEDIA_BIND_ADDRESS=127.0.0.1
MEDIA_PORT=8080
MEDIA_PUBLIC_BASE_URL=http://localhost:8080

# 服务结构化事件日志：DEBUG / INFO / WARNING / ERROR / CRITICAL，默认 INFO。
# DEBUG 增加脱敏阶段诊断；不会打开第三方 SDK 原始日志或 HTTP access log。
MEDIA_LOG_LEVEL=INFO
# 仅在 DEBUG 时生效，显式允许记录有长度上限的脱敏模型请求/响应正文。
# 正文可能包含任务内容；仅在需要排查时开启，诊断后关闭。
MEDIA_LOG_MODEL_CONTENT=false

# 生成器自动替换占位符。显式小写 null 开放服务；空值/缺失会拒绝启动。
MEDIA_SERVICE_TOKEN=replace-with-generated-token

# 相对路径按根目录 docker-compose.yaml 解析。
MEDIA_CONFIG_PATH=./deploy/local/media-config.json

# 容器资源；逻辑 Worker 数量在私有 JSON 的 worker_concurrency 配置。
MEDIA_CPUS=2.0
MEDIA_MEMORY=2g
MEDIA_PIDS_LIMIT=128

# 服务直接运行时，由 MEDIA_CONFIG_FILE 指定私有 JSON 文件。
# MEDIA_CONFIG_FILE=/absolute/path/to/media-config.json

# 服务本地启动默认读取当前目录 .env；MEDIA_ENV_FILE 可显式选择其他文件。
# Docker Compose 自动加载 .env，按白名单传入服务。进程 MEDIA_* 优先于文件值。
# 修改后执行 docker compose up -d --force-recreate --wait media。
# Key 只填写在本机私有文件中；不要公开 docker compose config / inspect 输出。
MEDIA_LLM_ENABLED=false
MEDIA_A2A_ENABLED=false
MEDIA_LLM_API_KEY=
MEDIA_LLM_MODEL=
MEDIA_LLM_BASE_URL=
# prompted 使用 JSON mode；确认供应商支持 JSON schema 后才选择 native。
MEDIA_LLM_OUTPUT_MODE=prompted
# false 显式关闭模型思考，true 开启；仅显式小写 null 省略扩展以兼容其他供应商。
MEDIA_LLM_ENABLE_THINKING=false
# 仅限制规划（含排队、纠错、校验和提交）；媒体执行另用 JSON task_timeout_seconds。
MEDIA_PLANNING_TIMEOUT_SECONDS=300
MEDIA_PLANNING_CONCURRENCY=2
MEDIA_PLANNING_MAX_OUTPUT_TOKENS=4096
MEDIA_MAX_AGENT_REQUESTS=32

# 兼容已有文件字段：llm_api_key、llm_default_model、llm_base_url。
# llm_provider 可以保留；统一通过配置的 OpenAI-compatible base URL 调用。
