# Docker Compose 启动设置；复制为 .env 后按需修改。
# Token、HTTP 来源认证及存储配置仍放在私有 JSON 配置。
COMPOSE_PROJECT_NAME=ffmpeg-agent
MEDIA_IMAGE=ffmpeg-agent:v1-local
BUILD_REVISION=local

# 默认仅本机可访问；远程调用通过受控 HTTPS 入口转发。
MEDIA_BIND_ADDRESS=127.0.0.1
MEDIA_PORT=8080

# 相对路径按根目录 docker-compose.yaml 解析。
MEDIA_CONFIG_PATH=./deploy/local/media-config.json

# 容器资源；逻辑 Worker 数量在私有 JSON 的 worker_concurrency 配置。
MEDIA_CPUS=2.0
MEDIA_MEMORY=2g
MEDIA_PIDS_LIMIT=128

# 服务直接运行时，由 MEDIA_CONFIG_FILE 指定私有 JSON 文件。
# MEDIA_CONFIG_FILE=/absolute/path/to/media-config.json

# 自然语言配置：仅在本地运行/验收显式读取指定 .env.local 时生效；不会自动 source。
# .env.local 不提交、不复制进镜像。API key 只填写在本机私有文件中。
# 覆盖顺序：MEDIA_* 进程环境 > 兼容别名进程环境 > MEDIA_* 文件值 > 兼容别名文件值。
# 返回的覆盖值由启动程序合并到私有 JSON；未出现的字段保留原配置。
MEDIA_LLM_ENABLED=false
MEDIA_A2A_ENABLED=false
MEDIA_LLM_API_KEY=replace-with-your-private-api-key
MEDIA_LLM_MODEL=replace-with-your-model-name
MEDIA_LLM_BASE_URL=https://provider.example/v1
# prompted 使用 JSON mode；确认供应商支持 JSON schema 后才选择 native。
MEDIA_LLM_OUTPUT_MODE=prompted
MEDIA_PLANNING_TIMEOUT_SECONDS=60
MEDIA_PLANNING_CONCURRENCY=2
MEDIA_PLANNING_MAX_OUTPUT_TOKENS=4096
MEDIA_MAX_AGENT_REQUESTS=32

# 兼容已有文件字段：llm_api_key、llm_default_model、llm_base_url。
# llm_provider 可以保留；统一通过配置的 OpenAI-compatible base URL 调用。
