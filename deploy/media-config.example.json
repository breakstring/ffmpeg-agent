{
  "state_dir": "/var/lib/ffmpeg-agent/state",
  "work_dir": "/var/lib/ffmpeg-agent/work",
  "service_caller": "demo",
  "storages": {
    "input": {"root": "/media/input", "role": "input", "callers": ["demo"]},
    "output": {"root": "/media/output", "role": "output", "callers": ["demo"]}
  },
  "callers": {
    "demo": {
      "default_output_storage": "output",
      "source_rules": []
    }
  },
  "worker_concurrency": 1,
  "ffmpeg_threads": 2,
  "ffmpeg_filter_threads": 1,
  "max_frame_count": 100,
  "max_frame_rate": 240,
  "public_base_url": "http://localhost:8080",
  "runtime_mode": "container",
  "engine_series": "7.1"
}
